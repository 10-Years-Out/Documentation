{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "CBC Documentation Lab",
  "colors": {
    "primary": "#4F46E5",
    "light": "#6366F1",
    "dark": "#A5B4FC"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "pages": [
      {
        "group": "Overview",
        "pages": [
          "index",
          "demo/tech-showcase"
        ]
      },
      {
        "group": "Client source of truth",
        "pages": [
          "client/overview"
        ]
      },
      {
        "group": "Switch implementation",
        "pages": [
          "switch/overview",
          "switch/prepare",
          "switch/configure",
          "switch/conditional-paths",
          "switch/validate"
        ]
      },
      {
        "group": "Client deliverables",
        "pages": [
          "deliverables/switch-configuration-record"
        ]
      },
      {
        "group": "Reference",
        "pages": [
          "reference/definitions",
          "reference/command-library",
          "reference/revisions"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Source repository",
          "href": "https://github.com/10-Years-Out/Documentation",
          "icon": "github"
        },
        {
          "anchor": "Mintlify documentation",
          "href": "https://mintlify.com/docs",
          "icon": "book-open"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "See the tech",
        "href": "/demo/tech-showcase"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Build a configuration",
      "href": "/switch/configure"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/10-Years-Out/Documentation"
    }
  }
}
